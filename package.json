{
  "name": "dependabot-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Training repo for a Dependabot walkthrough. Contains intentionally vulnerable dependency versions. Never deploy.",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "portal"
  ],
  "scripts": {
    "lint": "eslint . && yarn workspace portal lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "synth": "cdk synth --quiet",
    "typecheck": "tsc --noEmit && yarn workspace portal typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1148.1",
    "aws-cdk-lib": "2.270.0",
    "constructs": "10.8.1",
    "eslint": "9.39.4",
    "prettier": "3.8.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.0.3"
  }
}
